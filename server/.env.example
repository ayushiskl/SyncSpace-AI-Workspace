# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/syncspace-ai

# JWT Secret (Use a strong random secret in production)
JWT_SECRET=replace-with-a-strong-random-jwt-secret-key
JWT_EXPIRES_IN=7d

# Google Gemini API Configuration (Required for live AI agent features)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Collaboration Persistence Settings
SNAPSHOT_DEBOUNCE_MS=3000
ROOM_IDLE_TIMEOUT_MS=300000
